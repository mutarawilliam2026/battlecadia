# Battlecadia environment variables — TEMPLATE
#
# Copy this file to `.env.local` and fill in the real values:
#   cp .env.local.example .env.local
#
# `.env.local` is gitignored and must NEVER be committed. Only variables prefixed
# with NEXT_PUBLIC_ are exposed to the browser — keep every secret un-prefixed.

# --- TMDB (server-side only) -----------------------------------------------
# The movie data source. Use the API Read Access Token from your TMDB account
# settings (Settings → API → "API Read Access Token") — NOT the api_key query
# param. Sent as `Authorization: Bearer` on every call.
#   https://www.themoviedb.org/settings/api
TMDB_ACCESS_TOKEN=

# --- Google Gemini (server-side only) --------------------------------------
# Translates a plain-English prompt into structured TMDB discover filters.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Model id used for that translation, e.g. gemini-2.5-flash.
GEMINI_MODEL=

# --- Supabase (database + auth) --------------------------------------------
# Two clients, two keys (modern Supabase key format — sb_publishable_… /
# sb_secret_…, the equivalents of the legacy anon / service_role keys):
#
#   NEXT_PUBLIC_SUPABASE_URL             project URL — safe in the browser.
#   NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY RLS-respecting key — safe in the
#                                        browser. Used by the SSR server client
#                                        (lib/supabase/server.ts) for auth-scoped
#                                        reads once login ships.
#   SUPABASE_SECRET_KEY                  RLS-BYPASSING key — SERVER ONLY, never
#                                        NEXT_PUBLIC_. Used by the service client
#                                        (lib/supabase/service.ts) to write
#                                        battles/matchups. Leaking it lets anyone
#                                        read or write every row.
#
# Keys: Dashboard → Project Settings → API keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
